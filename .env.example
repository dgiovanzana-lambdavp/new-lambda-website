# Copy to .env.local and fill in. Commit no values.
#
# Every variable here is optional except DATABASE_URL. A missing key
# disables its feature and logs why — it does not break the form.

# ── Database — the system of record ─────────────────────────────────
# Local: use Railway's DATABASE_PUBLIC_URL (*.proxy.rlwy.net).
#        postgres.railway.internal does not resolve off Railway.
# Railway app service: set this to the reference ${{Postgres.DATABASE_URL}}
#        — not the Postgres service's own definition, whose ${{...}}
#        names do not resolve from another service.
# Netlify: use the PUBLIC url (*.proxy.rlwy.net) with ?sslmode=require.
#        Netlify builds and functions run outside Railway's network, so
#        the internal host fails there exactly as it does on a laptop.
#        Needed in BOTH contexts: the build runs migrations, the
#        functions read and write rows.
DATABASE_URL=

# Make a failed migration stop the deploy instead of continuing degraded.
#
# Off by default, which is right on Railway: there a failed migration
# used to leave no server at all, so booting degraded beats being down.
# netlify.toml sets it to 1, because there the same failure only stops
# the new build and the previous deploy keeps serving.
# MIGRATE_STRICT=1

# ── Email notifications (Resend) ────────────────────────────────────
RESEND_API_KEY=
LEAD_FROM_EMAIL=
LEAD_NOTIFICATION_EMAIL=info@lambdavp.com

# ── Cal.com — Tier A inline booking ─────────────────────────────────
# Without a real secret the webhook fails closed and rejects everything,
# which is the correct default.
CAL_WEBHOOK_SECRET=

# ── PostHog — analytics and no-deploy threshold changes ─────────────
# Never prefix a scoring flag with NEXT_PUBLIC_. That ships the
# thresholds to the browser and defeats server-side scoring.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=
