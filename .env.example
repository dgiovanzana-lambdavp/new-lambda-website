# Copy to .env.local and fill in. Commit no values.
#
# Every variable here is optional except DATABASE_URL. A missing key
# disables its feature and logs why — it does not break the form.

# ── Database — the system of record ─────────────────────────────────
# Local: use Railway's DATABASE_PUBLIC_URL (*.proxy.rlwy.net), or a
#        local Postgres URL. postgres.railway.internal does not resolve
#        off Railway.
# Railway app service: set this to the reference ${{Postgres.DATABASE_URL}}
#        — not the Postgres service's own definition, whose ${{...}}
#        names do not resolve from another service.
DATABASE_URL=

# One-off data copy (scripts/copy-from-netlify.mjs). Read-only source;
# target is DATABASE_URL. Only needed when resyncing from Netlify DB.
# SOURCE_DATABASE_URL=

# Make a failed migration stop the deploy instead of continuing degraded.
#
# Off by default on Railway: a failed migration used to leave no server
# at all, so booting degraded beats being down.
# MIGRATE_STRICT=1

# ── Email notifications (Resend) ────────────────────────────────────
RESEND_API_KEY=
LEAD_FROM_EMAIL=
LEAD_NOTIFICATION_EMAIL=info@lambdavp.com

# ── Cal.com webhook (legacy — only needed if Cal.com is re-enabled) ─
CAL_WEBHOOK_SECRET=

# ── PostHog — site-wide analytics + funnel + scoring flags ──────────
# Project 473817 (US cloud). The phc_ key is a public client token —
# safe in NEXT_PUBLIC_*; still set it per environment, do not rely on
# a hardcoded value in application source.
# Never prefix a scoring flag with NEXT_PUBLIC_. That ships the
# thresholds to the browser and defeats server-side scoring.
#
# Railway production and staging both need:
NEXT_PUBLIC_POSTHOG_KEY=phc_yKH2bLpfWTBPjofbY5dsAgYZBzPvqevPQwZ9eF34Vbhy
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional — server-only flag evaluation for scoring overrides:
POSTHOG_PERSONAL_API_KEY=
